#!/usr/bin/env bash

# Rebuild the BC deaths-by-CHSA dataset from the beginning of the
# available reporting period.
#
# This script:
#   1. Runs the Rust application in release mode.
#   2. Processes reports starting in 2007.
#   3. Re-downloads all source PDFs instead of using cached copies.
#   4. Generates both long- and wide-format CSV datasets.
#
# Outputs:
#   data/out/bc_deaths_by_chsa_long.csv
#   data/out/bc_deaths_by_chsa_wide.csv
#
# Usage:
#   ./run
#
# Requirements:
#   - Bash
#   - Rust/Cargo
#   - Internet access to download the BC death reports
#
# The script is intentionally kept as a thin wrapper around the Rust
# application's command-line interface. Application logic belongs in
# the Rust program rather than this script.

set -euo pipefail

# Resolve the repository root from the location of this script so that
# `./run` behaves consistently regardless of the caller's current
# working directory.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Run the application in release mode.
#
# --from 2007
#     Process reports beginning with 2007. The application's default
#     --to value is the current year.
#
# --wide
#     Generate both the normal long-format CSV and the wide-format CSV.
#
# --force
#     Re-download PDFs even when a cached copy already exists.
cargo run --release -- \
    --from 2007 \
    --wide \
    --force
