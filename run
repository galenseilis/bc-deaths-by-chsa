#!/usr/bin/env bash

# Regenerate the BC deaths-by-CHSA dataset.
#
# This script invokes the Rust application in release mode to download and
# parse BC death reports beginning with 2007. It generates both long- and
# wide-format CSV datasets.
#
# Existing PDF files are deliberately re-downloaded so that the generated
# dataset reflects the current source reports.
#
# Generated files:
#
#   data/out/bc_deaths_by_chsa_long.csv
#   data/out/bc_deaths_by_chsa_wide.csv
#
# Cached source PDFs are stored under:
#
#   data/pdfs/
#
# Usage:
#
#   ./run
#
# Requirements:
#
#   - Bash
#   - Rust and Cargo
#   - Internet access to download the BC reports
#
# The script is intentionally a thin wrapper around the Rust application's
# command-line interface. Parsing and dataset generation belong to the Rust
# application rather than this script.

set -euo pipefail

# Resolve the repository directory from the location of this script so that
# the script behaves consistently regardless of the caller's current
# working directory.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

cargo run --release -- \
    --from 2007 \
    --wide \
    --force
